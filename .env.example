# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Clave que firma las sesiones. Usa una larga y aleatoria.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Conexión a MongoDB local (la misma que usas en Compass)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=campo_alegre

# Contraseñas iniciales que crea seed.py. Cámbialas antes de usar el sistema en la finca.
SEED_ADMIN_PASSWORD=Admin2026!
SEED_EMPLEADO_PASSWORD=Empleado2026!

# (Opcional) Carpeta donde se guardan las copias de seguridad. Por defecto: "respaldos" dentro del proyecto.
# Puede ser un disco externo, por ejemplo: RESPALDOS_DIR=E:\RespaldosCampoAlegre
#RESPALDOS_DIR=
